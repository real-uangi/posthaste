# Copy to .env for local configuration. Never commit real values.
# PostgreSQL is an external dependency; this file does not start it.
DB_DSN=postgres://posthaste:CHANGE_ME@127.0.0.1:5432/posthaste?sslmode=disable
POSTHASTE_PUBLIC_URL=https://notify.example.com
POSTHASTE_ADMIN_PASSWORD=CHANGE_ME_ADMIN_PASSWORD
POSTHASTE_INGRESS_TOKEN=CHANGE_ME_DISTINCT_INGRESS_TOKEN
# Required: standard Base64 encoding of a randomly generated 32-byte key.
POSTHASTE_ENCRYPTION_KEY=
RUN_MODE=release
HTTP_PORT=8080
POSTHASTE_EVENTBUS_EXECUTORS=4
POSTHASTE_EVENTBUS_DISPATCHER_QUEUE_SIZE=64
POSTHASTE_EVENTBUS_EXECUTOR_QUEUE_SIZE=64
POSTHASTE_SEND_TIMEOUT=5s
